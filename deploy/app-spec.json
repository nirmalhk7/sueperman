{
  "name": "sueperman",
  "services": [
    {
      "name": "api",
      "dockerfile_path": "services/api/Dockerfile",
      "http_port": 8080,
      "instance_count": 1,
      "instance_size_slug": "apps-s-1vcpu-0.5gb",
      "health_check": {
        "http_path": "/api/health"
      },
      "envs": [
        {
          "key": "FRONTEND_ORIGIN",
          "value": "${APP_URL}",
          "scope": "RUN_TIME",
          "type": "GENERAL"
        },
        {
          "key": "DATABASE_URL",
          "value": "sqlite:////data/sueperman.db",
          "scope": "RUN_TIME",
          "type": "GENERAL"
        },
        {
          "key": "DEMO_MODE",
          "value": "true",
          "scope": "RUN_TIME",
          "type": "GENERAL"
        },
        {
          "key": "CPSC_LIVE_ENABLED",
          "value": "true",
          "scope": "RUN_TIME",
          "type": "GENERAL"
        },
        {
          "key": "SETTLEMENT_LIVE_ENABLED",
          "value": "true",
          "scope": "RUN_TIME",
          "type": "GENERAL"
        },
        {
          "key": "GEMINI_ENABLED",
          "value": "false",
          "scope": "RUN_TIME",
          "type": "GENERAL"
        },
        {
          "key": "OPENAI_ENABLED",
          "value": "false",
          "scope": "RUN_TIME",
          "type": "GENERAL"
        },
        {
          "key": "BRIGHTDATA_ENABLED",
          "value": "false",
          "scope": "RUN_TIME",
          "type": "GENERAL"
        },
        {
          "key": "GEMINI_MODEL",
          "value": "gemini-3.5-flash-lite",
          "scope": "RUN_TIME",
          "type": "GENERAL"
        },
        {
          "key": "OPENAI_MAX_CALLS_PER_RUN",
          "value": "3",
          "scope": "RUN_TIME",
          "type": "GENERAL"
        },
        {
          "key": "SENTRY_ENVIRONMENT",
          "value": "production",
          "scope": "RUN_TIME",
          "type": "GENERAL"
        }
      ],
      "git": {
        "repo_clone_url": "https://github.com/nirmalhk7/sueperman.git",
        "branch": "codex/sueperman"
      }
    },
    {
      "name": "web",
      "dockerfile_path": "apps/web/Dockerfile",
      "http_port": 8080,
      "instance_count": 1,
      "instance_size_slug": "apps-s-1vcpu-0.5gb",
      "health_check": {
        "http_path": "/"
      },
      "git": {
        "repo_clone_url": "https://github.com/nirmalhk7/sueperman.git",
        "branch": "codex/sueperman"
      }
    }
  ],
  "ingress": {
    "rules": [
      {
        "match": {
          "path": {
            "prefix": "/api"
          }
        },
        "component": {
          "name": "api",
          "preserve_path_prefix": true
        }
      },
      {
        "match": {
          "path": {
            "prefix": "/"
          }
        },
        "component": {
          "name": "web",
          "preserve_path_prefix": true
        }
      }
    ]
  }
}
