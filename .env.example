DEMO_MODE=true
DATABASE_URL=sqlite:///./sueperman.db
CPSC_LIVE_ENABLED=false
SETTLEMENT_LIVE_ENABLED=false
GEMINI_ENABLED=false
BRIGHTDATA_ENABLED=false
OPENAI_ENABLED=false
OPENAI_RECEIPT_ENABLED=false
OPENAI_RECEIPT_MODEL=gpt-6-luna
OPENAI_RECEIPT_DAILY_LIMIT=10
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
BRIGHTDATA_API_TOKEN=
OPENAI_API_KEY=
OPENAI_DECISION_MODEL=gpt-6-luna
OPENAI_MAX_CALLS_PER_RUN=3
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Operator-only deployment credential; never pass to app services.
DIGITALOCEAN_ACCESS_TOKEN=

# V2 offline collaboration: synthetic products only, one active run, three local roles. Daily quota includes answers and survives reset.
COLLABORATION_RUN_SECONDS=90
COLLABORATION_DAILY_LIMIT=30
# Live calls require every provider setup below. Default-off; server-only secrets.
# See docs/diwali-runtime.md before enabling. No automatic paid retry.
COLLABORATION_LIVE_ENABLED=false
BAND_ENABLED=false
AGENT37_ENABLED=false
ADAL_ENABLED=false
FINCH_ENABLED=false
LYZR_ENABLED=false

BAND_ROOM_ID=
# Four separately registered identities: controller, scout, skeptic, builder.
BAND_IDENTITIES={}
BAND_API_KEYS={}
AGENT37_API_KEY=
AGENT37_INSTANCE_ID=
AGENT37_WORKER_REVISION=
AGENT37_ISOLATION_VERIFIED=false
# Reviewed OS-isolating launcher wrapping authenticated AdaL CLI; not the raw CLI.
ADAL_RUNTIME_PATH=
ADAL_RUNTIME_SHA256=
ADAL_ISOLATION_VERIFIED=false
FINCH_MANIFEST_PATH=
FINCH_PACKAGE_PATH=
LYZR_API_KEY=
LYZR_CHAT_URL=
LYZR_AGENT_ID=
LYZR_USER_ID=
# v3_inference or v3_agent, copied from the actual Studio workspace.
LYZR_API_PROFILE=
# Optional tested Docker isolation launcher (never put auth files in the repository).
ADAL_SANDBOX_IMAGE=
ADAL_BUNDLE_DIR=
ADAL_BUNDLE_SHA256=
ADAL_AUTH_DIRECTORY=
# Exact authenticated runtime HTTPS hosts, comma-separated; empty denies all egress.
ADAL_ALLOWED_HOSTS=
