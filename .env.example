BRIGHTDATA_API_TOKEN=
OPENAI_API_KEY=
OPENAI_DECISION_MODEL=gpt-6-luna
OPENAI_MAX_CALLS_PER_RUN=3
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Operator-only deployment credential; never pass to app services.
DIGITALOCEAN_ACCESS_TOKEN=

# V2 deterministic replay needs no sponsor keys. Live activation remains blocked
# until all five real sponsor adapters/permissions/handshakes are verified.
COLLABORATION_LIVE_ENABLED=false
# Keep true on any shared deployment: only repository synthetic demo purchases.
COLLABORATION_PUBLIC_DEMO=true
COLLABORATION_TIMEOUT_SECONDS=90

# V2 P1: additional reviewed notices and local evidence-readiness checklist.
P1_ENABLED=false
# Daily public-source watches additionally require CPSC_LIVE_ENABLED and user opt-in.
P1_MONITOR_ENABLED=false
P1_MONITOR_POLL_SECONDS=60
